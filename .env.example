# Copy to `.env` and fill in the values from the Supabase dashboard
# (Project settings -> API Keys).
#
# The `EXPO_PUBLIC_` prefix is required: Expo's bundler only inlines variables
# with that prefix into the client JavaScript bundle. `NEXT_PUBLIC_*` and
# unprefixed names are silently dropped.
#
# Use the publishable key only. The service_role key must never reach the app.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here